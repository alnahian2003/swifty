DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=swifty
DB_CHARSET=utf8mb4

# SQLite Configuration (when DB_DRIVER=sqlite)
# DB_NAME=/path/to/database.sqlite

# PostgreSQL Configuration (when DB_DRIVER=pgsql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_NAME=swifty

# Application Settings
APP_ENV=development
APP_DEBUG=true
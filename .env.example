DATABASE_CONNECTION=mysql

# MySQL Configuration (when DATABASE_CONNECTION=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=swifty
DB_CHARSET=utf8mb4

# PostgreSQL Configuration (when DATABASE_CONNECTION=pgsql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
